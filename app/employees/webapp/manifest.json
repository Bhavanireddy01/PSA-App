{
  "_version": "1.60.0",
  "sap.app": {
    "id": "employees",
    "type": "application",
    "title": "Employees",
    "description": "Employees and their timesheets",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/psa/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      },
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.fe.templates": {}
      }
    },
    "sap.ui5": {
  "extends": {
    "extensions": {
      "sap.ui.controllerExtensions": {
        "sap.fe.templates.ObjectPage.ObjectPageController": {
          "controllerName": "employees.ext.Timesheets"
        }
      }
    }
  }
},
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": false,
          "groupProperties": {
            "default": {
              "submit": "Auto"
            }
          }
        }
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "EmployeesList",
          "target": "EmployeesList"
        },
        {
          "pattern": "Employees({key}):?query:",
          "name": "EmployeesObjectPage",
          "target": "EmployeesObjectPage"
        }
      ],
      "targets": {
        "EmployeesList": {
          "type": "Component",
          "id": "EmployeesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Employees",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "Employees": {
                  "detail": {
                    "route": "EmployeesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "EmployeesObjectPage": {
  "type": "Component",
  "id": "EmployeesObjectPage",
  "name": "sap.fe.templates.ObjectPage",
  "options": {
    "settings": {
      "contextPath": "/Employees",
      "editableHeaderContent": false,
      "controlConfiguration": {
        "timesheets/@com.sap.vocabularies.UI.v1.LineItem#EmpTimesheets": {
          "tableSettings": {
            "type": "ResponsiveTable",
            "selectionMode": "Multi"
          },
          "actions": {
            "CustomCreateTimesheet": {
              "press": "employees.ext.Timesheets.onCreateTimesheet",
              "visible": true,
              "enabled": true,
              "text": "Create Timesheet"
            }
          }
        }
      }
    }
  }
}
      }
    }
  }
}